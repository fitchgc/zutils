{
  "name": "@fitchgc/zutils",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js",
      "require": "./dist/utils/*.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "utils/*": [
        "dist/utils/*.d.ts"
      ]
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "lint": "eslint --ext .ts src/**",
    "format": "eslint --ext .ts src/** --fix",
    "test": "jest"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.44.0",
    "crypto-js": "^4.2.0",
    "ethers": "^6.15.0",
    "redis": "^3.1.2",
    "scrypt-js": "^3.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@swc/core": "^1.13.5",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.13",
    "@types/redis": "^2.8.28",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  }
}
